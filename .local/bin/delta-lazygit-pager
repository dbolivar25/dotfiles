#!/usr/bin/env bash
set -euo pipefail

delta_args=(--paging=never)

# Lazygit owns the terminal, so query macOS instead of terminal colors.
if [[ "$(uname -s)" == "Darwin" ]]; then
  if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)" == "Dark" ]]; then
    delta_args+=(--dark)
  else
    delta_args+=(--light)
  fi
fi

exec delta "${delta_args[@]}" "$@"
