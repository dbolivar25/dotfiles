#!/usr/bin/env bash
set -euo pipefail

config_dir="${GHOSTTY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/ghostty}"
theme_file="$config_dir/theme.local"
mode_file="$config_dir/theme-mode"
lock_file="${TMPDIR:-/tmp}/ghostty-theme-${UID}.lock"

acquire_lock() {
  local attempts=0

  while ! /usr/bin/shlock -f "$lock_file" -p "$$"; do
    attempts=$((attempts + 1))
    if [[ "$attempts" -ge 100 ]]; then
      printf 'ghostty-theme: another theme switch is still running\n' >&2
      exit 1
    fi
    /bin/sleep 0.05
  done

  trap '/bin/rm -f "$lock_file"' EXIT
}

write_path() {
  local path="$1"

  if [[ -L "$path" ]]; then
    realpath "$path"
  else
    printf '%s\n' "$path"
  fi
}

write_atomic() {
  local path="$1"
  local write_target
  local tmp

  write_target="$(write_path "$path")"
  tmp="$(mktemp "${write_target}.tmp.XXXXXX")"
  cat >"$tmp"
  mv "$tmp" "$write_target"
}

reload_ghostty() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    return
  fi

  if ! /usr/bin/pgrep -x ghostty >/dev/null; then
    return
  fi

  /usr/bin/osascript <<'APPLESCRIPT' >/dev/null
tell application "Ghostty"
  if (count of windows) is 0 then return
  set activeTerminal to focused terminal of selected tab of front window
  perform action "reload_config" on activeTerminal
end tell
APPLESCRIPT
}

sync_herdr() {
  local mode="$1"
  local herdr_theme
  local herdr_config
  local herdr_bin
  local tmp
  local config_mode
  local write_target

  herdr_bin="${HERDR_BIN:-$HOME/.local/bin/herdr}"
  if [[ ! -x "$herdr_bin" ]]; then
    herdr_bin="$(command -v herdr || true)"
    if [[ -z "$herdr_bin" ]]; then
      return
    fi
  fi

  herdr_config="${HERDR_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}"
  if [[ ! -f "$herdr_config" ]]; then
    return
  fi

  case "$mode" in
    light)
      herdr_theme="rose-pine-dawn"
      ;;
    dark)
      herdr_theme="rose-pine"
      ;;
  esac

  write_target="$(write_path "$herdr_config")"
  tmp="$(mktemp "${write_target}.tmp.XXXXXX")"
  config_mode="$(stat -L -f '%Lp' "$herdr_config")"

  awk -v selected_theme="$herdr_theme" '
    function emit_missing_theme_keys() {
      if (!saw_name) {
        print "name = \"" selected_theme "\""
      }
      if (!saw_auto_switch) {
        print "auto_switch = false"
      }
    }

    BEGIN {
      in_theme = 0
      found_theme = 0
      saw_name = 0
      saw_auto_switch = 0
    }

    /^\[[^]]+\][[:space:]]*$/ {
      if (in_theme) {
        emit_missing_theme_keys()
      }

      in_theme = ($0 == "[theme]")
      if (in_theme) {
        found_theme = 1
        saw_name = 0
        saw_auto_switch = 0
      }

      print
      next
    }

    in_theme && /^[[:space:]]*name[[:space:]]*=/ {
      print "name = \"" selected_theme "\""
      saw_name = 1
      next
    }

    in_theme && /^[[:space:]]*auto_switch[[:space:]]*=/ {
      print "auto_switch = false"
      saw_auto_switch = 1
      next
    }

    {
      print
    }

    END {
      if (in_theme) {
        emit_missing_theme_keys()
      } else if (!found_theme) {
        print ""
        print "[theme]"
        print "name = \"" selected_theme "\""
        print "auto_switch = false"
      }
    }
  ' "$herdr_config" >"$tmp"

  chmod "$config_mode" "$tmp"
  HERDR_CONFIG_PATH="$tmp" "$herdr_bin" config check >/dev/null
  mv "$tmp" "$write_target"

  "$herdr_bin" server reload-config >/dev/null 2>&1 || true
}

sync_hunk() {
  local mode="$1"
  local hunk_theme
  local hunk_config
  local tmp
  local config_mode
  local write_target

  hunk_config="${HUNK_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/hunk/config.toml}"
  if [[ ! -f "$hunk_config" ]]; then
    return
  fi

  case "$mode" in
    light)
      hunk_theme="rose-pine-dawn"
      ;;
    dark)
      hunk_theme="rose-pine"
      ;;
  esac

  write_target="$(write_path "$hunk_config")"
  tmp="$(mktemp "${write_target}.tmp.XXXXXX")"
  config_mode="$(stat -L -f '%Lp' "$hunk_config")"

  awk -v selected_theme="$hunk_theme" '
    BEGIN {
      in_root = 1
      wrote_theme = 0
    }

    in_root && /^[[:space:]]*theme[[:space:]]*=/ {
      print "theme = \"" selected_theme "\""
      wrote_theme = 1
      next
    }

    /^\[[^]]+\][[:space:]]*$/ {
      if (in_root && !wrote_theme) {
        print "theme = \"" selected_theme "\""
        print ""
        wrote_theme = 1
      }
      in_root = 0
    }

    {
      print
    }

    END {
      if (!wrote_theme) {
        print "theme = \"" selected_theme "\""
      }
    }
  ' "$hunk_config" >"$tmp"

  chmod "$config_mode" "$tmp"
  mv "$tmp" "$write_target"
}

if [[ "$#" -ne 1 || ( "$1" != "light" && "$1" != "dark" ) ]]; then
  printf 'usage: %s light|dark\n' "$0" >&2
  exit 2
fi

acquire_lock

mode="$1"

case "$mode" in
  light)
    ghostty_theme="Rose Pine Dawn"
    ;;
  dark)
    ghostty_theme="Rose Pine"
    ;;
esac

mkdir -p "$config_dir"

write_atomic "$theme_file" <<EOF
# Generated by ghostty-theme. Do not edit.
theme = $ghostty_theme
palette = 4=#43728C
palette = 12=#43728C
EOF

write_atomic "$mode_file" <<EOF
$mode
EOF

reload_ghostty
sync_hunk "$mode"
sync_herdr "$mode"

printf 'theme=%s ghostty="%s"\n' "$mode" "$ghostty_theme"
